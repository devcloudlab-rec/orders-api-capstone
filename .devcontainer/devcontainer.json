{
  "name": "orders-api-agent",
  "image": "agent-sandbox:2.1.319",
  "initializeCommand": "sandbox/ensure-egress.sh",
  "runArgs": [
    "--network", "agent-internal",
    "--read-only",
    "--cap-drop", "ALL",
    "--security-opt", "no-new-privileges"
  ],
  "containerEnv": {
    "HTTPS_PROXY": "http://agent-egress:8888",
    "HTTP_PROXY": "http://agent-egress:8888"
  },
  "mounts": ["source=${localWorkspaceFolder},target=/workspace,type=bind,readonly"],
  "workspaceFolder": "/workspace",
  "remoteUser": "agent"
}
